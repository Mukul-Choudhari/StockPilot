@{
    var c = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – StockPilot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar">
        <div class="brand"><i>S</i> StockPilot</div>
        <a class="nav-item @(c == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">📊 Dashboard</a>
        <a class="nav-item @(c == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index">📦 Products</a>
        <a class="nav-item @(c == "Warehouses" ? "active" : "")" asp-controller="Warehouses" asp-action="Index">🏭 Warehouses</a>
        <a class="nav-item @(c == "Movements" ? "active" : "")" asp-controller="Movements" asp-action="Index">🔁 Movements</a>
        <div class="user">
            <div class="mb-2">@User.Identity?.Name<br /><span class="text-white-50">@(User.IsInRole("Admin") ? "Admin" : "Warehouse staff")</span></div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-sm btn-outline-light w-100">Log out</button>
            </form>
        </div>
    </aside>
    <main class="main">@RenderBody()</main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>