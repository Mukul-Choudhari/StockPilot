@model StockPilot.Web.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in – StockPilot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <style>
            .hero {
                min-height: 100vh;
                color: #fff;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 3rem 4rem;
                background: linear-gradient(160deg,rgba(20,33,61,.93),rgba(20,33,61,.6)),url('/images/warehouse.jpg') center/cover,var(--navy)
            }

                .hero h1 {
                    font-weight: 800;
                    font-size: 2.8rem;
                    max-width: 16ch;
                    line-height: 1.1
                }

                .hero li {
                    margin-bottom: .5rem;
                    opacity: .9
                }

            .panel {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2rem;
                background: #fff
            }

                .panel form {
                    width: 100%;
                    max-width: 380px
                }
    </style>
</head>
<body>
    <div class="row g-0">
        <div class="col-lg-7 d-none d-lg-block">
            <div class="hero">
                <div class="brand mb-0"><i>S</i> StockPilot</div>
                <div>
                    <h1>Every unit, in every warehouse.</h1>
                    <ul class="list-unstyled mt-4">
                        <li>✔ Real-time stock across locations</li>
                        <li>✔ Safe transfers with a full audit trail</li>
                        <li>✔ Low-stock alerts before you run out</li>
                    </ul>
                </div>
                <div class="opacity-50 small">Inventory management demo</div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="panel">
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <h3 class="fw-bold mb-1">Welcome back</h3>
                    <p class="text-muted mb-4">Sign in to manage your inventory.</p>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control form-control-lg" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Keep me signed in</label>
                    </div>
                    <button type="submit" class="btn btn-gold btn-lg w-100">Sign in</button>
                    <p class="text-muted small mt-4 mb-0">Demo login: admin@stockpilot.demo / Demo@12345</p>
                </form>
            </div>
        </div>
    </div>
</body>
</html>