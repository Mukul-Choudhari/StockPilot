@{
    ViewData["Title"] = "Dashboard";
}
<div class="banner mb-4">
    <h2 class="fw-bold">Welcome back, @(User.Identity?.Name?.Split('@')[0])</h2>
    <p class="mb-0 opacity-75">Here is what is happening across your warehouses.</p>
</div>
<div class="row g-3 mb-3" id="kpis"></div>
<div class="row g-3">
    <div class="col-lg-7"><div class="card-x"><h5 class="mb-3">Stock by warehouse</h5><canvas id="wh" height="150"></canvas></div></div>
    <div class="col-lg-5"><div class="card-x h-100"><h5 class="mb-3">Low stock</h5><div id="low"></div></div></div>
    <div class="col-12">
        <div class="card-x">
            <h5 class="mb-3">Recent activity</h5>
            <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>When</th><th>Product</th><th>Warehouse</th><th>Type</th><th class="text-end">Change</th><th>By</th></tr></thead><tbody id="recent"></tbody></table></div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (async () => {
            const s = await api('/api/dashboard/stats');
            const kpi = (l, v, sub) => `<div class="col-6 col-xl-3"><div class="card-x kpi"><div class="label">${l}</div><div class="value">${v}</div><div class="label">${sub}</div></div></div>`;
            $('#kpis').innerHTML =
                kpi('Total units', s.totalUnits.toLocaleString('en-IN'), s.productCount + ' products') +
                kpi('Stock value', money(s.stockValue), 'at list price') +
                kpi('Warehouses', s.warehouseCount, 'active locations') +
                kpi('Low stock', s.lowStock.length, s.lowStock.length ? 'need reordering' : 'all healthy');

            new Chart($('#wh'), {
                type: 'bar',
                data: { labels: s.byWarehouse.map(x => x.name), datasets: [{ data: s.byWarehouse.map(x => x.units), backgroundColor: '#14213d', borderRadius: 6 }] },
                options: { plugins: { legend: { display: false } } }
            });

            $('#low').innerHTML = s.lowStock.length
                ? s.lowStock.map(i => `<div class="d-flex justify-content-between align-items-center border-bottom py-2"><div><b>${esc(i.name)}</b><div class="text-muted small">${esc(i.sku)}</div></div><span class="badge-low">${i.total} / ${i.reorderLevel}</span></div>`).join('')
                : '<p class="text-muted">Everything is above its reorder level.</p>';

            $('#recent').innerHTML = s.recent.map(m => `<tr><td>${when(m.at)}</td><td>${esc(m.product)}</td><td>${esc(m.warehouse)}</td><td>${esc(m.type)}</td>
            <td class="text-end fw-bold ${m.delta > 0 ? 'text-success' : 'text-danger'}">${m.delta > 0 ? '+' : ''}${m.delta}</td><td>${esc(m.user ?? '')}</td></tr>`).join('');
        })();
    </script>
}