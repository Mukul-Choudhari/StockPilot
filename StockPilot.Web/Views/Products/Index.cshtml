@{
    ViewData["Title"] = "Products"; var admin = User.IsInRole("Admin");
}
<div class="d-flex flex-wrap gap-2 align-items-center mb-4">
    <h2 class="me-auto mb-0">Products</h2>
    <input id="q" class="form-control" style="max-width:240px" placeholder="Search name or SKU" />
    <select id="cat" class="form-select" style="max-width:180px"></select>
    @if (admin)
    {
        <button class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#addModal">+ Add product</button>
    }
</div>
<div class="row g-3" id="grid"></div>

<div class="modal fade" id="adjModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="adjTitle">Adjust stock</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <label class="form-label">Warehouse</label><select id="adjWh" class="form-select mb-3"></select>
                <label class="form-label">Change (use a minus sign to remove stock)</label><input id="adjDelta" type="number" class="form-control mb-3" value="1" />
                <label class="form-label">Note</label><input id="adjNote" class="form-control" placeholder="e.g. Damaged, recount" />
            </div>
            <div class="modal-footer"><button class="btn btn-gold" onclick="saveAdj()">Save</button></div>
        </div>
    </div>
</div>

@if (admin)
{
    <div class="modal fade" id="addModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Add product</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body row g-3">
                    <div class="col-6"><label class="form-label">SKU</label><input id="aSku" class="form-control" /></div>
                    <div class="col-6"><label class="form-label">Category</label><input id="aCat" class="form-control" placeholder="General" /></div>
                    <div class="col-12"><label class="form-label">Name</label><input id="aName" class="form-control" /></div>
                    <div class="col-6"><label class="form-label">Price (₹)</label><input id="aPrice" type="number" class="form-control" /></div>
                    <div class="col-6"><label class="form-label">Reorder level</label><input id="aReorder" type="number" class="form-control" /></div>
                </div>
                <div class="modal-footer"><button class="btn btn-gold" onclick="saveAdd()">Create</button></div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        let items = [], whs = [], adjId = 0;
        function draw() {
            const q = $('#q').value.toLowerCase(), c = $('#cat').value;
            const list = items.filter(p => (!c || p.category === c) && (p.name + p.sku).toLowerCase().includes(q));
            $('#grid').innerHTML = list.map(p => `<div class="col-sm-6 col-lg-4 col-xxl-3"><div class="card-x h-100">${pimg(p)}
            <div class="d-flex justify-content-between gap-2 mt-3"><b>${esc(p.name)}</b><span class="${p.total < p.reorderLevel ? 'badge-low' : 'badge-ok'}">${p.total} in stock</span></div>
            <div class="text-muted small">${esc(p.sku)} · ${esc(p.category)}</div>
            <div class="d-flex justify-content-between align-items-center mt-2"><span class="fw-bold">${money(p.price)}</span>
            <button class="btn btn-sm btn-outline-dark" onclick="openAdj(${p.id})">Adjust</button></div></div></div>`).join('')
                || '<p class="text-muted">No products found.</p>';
        }
        async function load() {
            const keep = $('#cat').value;
            const [r, w] = await Promise.all([api('/api/products?pageSize=100'), api('/api/warehouses')]);
            items = r.items; whs = w;
            $('#cat').innerHTML = '<option value="">All categories</option>' + [...new Set(items.map(p => p.category))].sort().map(c => `<option>${esc(c)}</option>`).join('');
            $('#cat').value = keep;
            $('#adjWh').innerHTML = whs.map(x => `<option value="${x.id}">${esc(x.name)}</option>`).join('');
            draw();
        }
        function openAdj(id) {
            adjId = id; $('#adjTitle').textContent = 'Adjust: ' + items.find(p => p.id === id).name;
            bootstrap.Modal.getOrCreateInstance($('#adjModal')).show();
        }
        async function saveAdj() {
            try {
                await api('/api/stock/adjust', { method: 'POST', body: { productId: adjId, warehouseId: +$('#adjWh').value, delta: +$('#adjDelta').value, note: $('#adjNote').value || null } });
                bootstrap.Modal.getInstance($('#adjModal')).hide(); toast('Stock updated'); await load();
            } catch (e) { toast(e.message, false); }
        }
        async function saveAdd() {
            try {
                await api('/api/products', { method: 'POST', body: { sku: $('#aSku').value, name: $('#aName').value, category: $('#aCat').value || 'General', price: +$('#aPrice').value || 0, reorderLevel: +$('#aReorder').value || 0 } });
                bootstrap.Modal.getInstance($('#addModal')).hide(); toast('Product created'); await load();
            } catch (e) { toast(e.message, false); }
        }
        $('#q').addEventListener('input', draw); $('#cat').addEventListener('change', draw);
        load();
    </script>
}